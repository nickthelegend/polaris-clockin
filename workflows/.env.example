# Copy to workflows/.env (git-ignored). Read by `cre workflow simulate` from this folder.

# The key `cre workflow simulate --broadcast` signs the forwarder transaction with.
# 64 hex characters, no quotes. For local-settings, `pnpm chain:local` prints a
# funded local test key to use. For staging-settings it needs testnet MON, and its
# address must be UnderwritingReceiver's simulationTransmitter
# (CRE_SIMULATION_TRANSMITTER when deploying the contracts).
CRE_ETH_PRIVATE_KEY=

# Provider keys for the underwriting workflow (secrets.yaml maps these ids).
# A provider without a key is left out; missing evidence is never attested as zero.
NANSEN_API_KEY=
ZERION_API_KEY=
ETHERSCAN_API_KEY=
# Confidential HTTP also needs ZERION_BASIC_AUTH = base64("<ZERION_API_KEY>:").
# Don't set it here: the pnpm scripts that start `cre workflow simulate`
# derive it from ZERION_API_KEY (scripts/cre.mjs).

# Shared with the Polaris API: HMAC key for the signed run callbacks (dunning).
POLARIS_CALLBACK_SECRET=

# production-settings only: a dedicated Monad testnet RPC.
MONAD_TESTNET_RPC_URL=
