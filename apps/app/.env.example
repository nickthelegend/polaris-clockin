# Copy to .env.local. Every value here is public: NEXT_PUBLIC_* is inlined into
# the browser bundle at build time.

# The WebAuthn relying party. A passkey, and so a Polaris account, is tied to
# it forever. Production: polarispay.app (serves app. and pay.). Leave it unset
# in dev to use the page's hostname (localhost).
# NEXT_PUBLIC_RP_ID=polarispay.app

# Dev only. "1" replaces Face ID with a random key kept in this tab's
# sessionStorage, so flows can be exercised headlessly. A "Dev signer" badge
# shows whenever it is on. Never set it in a deployed environment.
# NEXT_PUBLIC_DEV_SIGNER=1

# Chain. 10143 is Monad testnet, 143 is Monad mainnet.
# NEXT_PUBLIC_CHAIN_ID=10143
# NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com

# Verifying contracts. EIP-712 domains are read from these at runtime
# (ERC-5267 eip712Domain). Unset contracts sign against a local placeholder
# domain, which is only good for the stub relayer.
# NEXT_PUBLIC_AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
# NEXT_PUBLIC_PAYMENTS_ADDRESS=
# NEXT_PUBLIC_CHECKOUT_ADDRESS=
# NEXT_PUBLIC_SEND_ADDRESS=
# NEXT_PUBLIC_LOAN_ENGINE_ADDRESS=
