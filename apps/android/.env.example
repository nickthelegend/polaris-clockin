# apps/android: copy to .env (git-ignored). Every value is optional.

# ── What the app opens ───────────────────────────────────────────────────────
# The hosted Polaris app (https only; no port). Default https://app.polarispay.app/
# Setting another host rewrites twa-manifest.json and regenerates the project on
# the next `generate` or `build` (the diff shows exactly what changed).
# POLARIS_ANDROID_APP_URL=https://app.polarispay.app/

# ── Toolchain ────────────────────────────────────────────────────────────────
# A JDK, 17 or later (Bubblewrap's is 17). Else JAVA_HOME, then Bubblewrap's
# (~/.bubblewrap), then Android Studio's bundled one.
# POLARIS_ANDROID_JDK=
# The Android SDK. Else ANDROID_HOME, ANDROID_SDK_ROOT, Bubblewrap's, then the
# platform default (%LOCALAPPDATA%\Android\Sdk, ~/Library/Android/sdk, ~/Android/Sdk).
# POLARIS_ANDROID_SDK=
# Gradle's cache and wrapper. Else GRADLE_USER_HOME, then apps/android/.toolchain/gradle.
# GRADLE_USER_HOME=

# ── Signing ──────────────────────────────────────────────────────────────────
# Unset: a local debug key, made on the first build in .keys/ (git-ignored) with
# random passwords kept beside it. Set all of these for an upload/release key.
# Never commit a keystore or its passwords.
# POLARIS_ANDROID_KEYSTORE=/absolute/path/to/upload.keystore
# POLARIS_ANDROID_KEY_ALIAS=upload
# POLARIS_ANDROID_KEYSTORE_PASSWORD=
# POLARIS_ANDROID_KEY_PASSWORD=
