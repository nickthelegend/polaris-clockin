# Polaris for Business. Copy to .env.local and fill in. Every value here is
# read on the server only unless it starts with NEXT_PUBLIC_.

# ── Privy: sign-in (client + server) ─────────────────────────────────────────
# Dashboard > App settings. Without it the app renders a setup screen and every
# dashboard route answers 503. The checkout API and the relayer don't need it.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: an "app client" ID, if you created one for this origin.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# PRIVY_APP_ID falls back to NEXT_PUBLIC_PRIVY_APP_ID when unset.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: Dashboard > Configuration > App settings > Verification key.
PRIVY_VERIFICATION_KEY=

# ── The dashboard's own signing (client) ─────────────────────────────────────
# AUSD, for withdrawals the payout wallet signs in the browser. Unset: read from
# /api/public/network (the deployment record). Real AUSD's EIP-712 name is
# "Agora Dollar" (not its ERC-20 name), version "1".
NEXT_PUBLIC_AUSD_ADDRESS=
NEXT_PUBLIC_AUSD_EIP712_NAME=Agora Dollar
NEXT_PUBLIC_AUSD_EIP712_VERSION=1

# ── Chain ────────────────────────────────────────────────────────────────────
# The deployment record the server serves: packages/contracts/deployments/<name>.json
# (monad-testnet after `deploy:monad`, monad-local after `deploy:local`), or a path.
POLARIS_DEPLOYMENT=monad-testnet
# POLARIS_DEPLOYMENT_FILE=../../packages/contracts/deployments/monad-local.json
# Our own RPC (default: Monad testnet's public one). Monad's public RPC caps
# eth_getLogs at 100 blocks; the chain sync reads in 100-block ranges there.
POLARIS_RPC_URL=
# POLARIS_EXPLORER_URL=https://testnet.monadvision.com
# POLARIS_SYNC_FROM_BLOCK=   # first block the chain sync reads (default: the current one)

# ── The relayer (docs/research/privy.md §5.5) ───────────────────────────────
# privy: a policy-locked Privy server wallet signs every relayed call
#        (created by `pnpm --filter @polaris/business privy:setup-relayer -- --apply`).
# local: a raw key, for a local Hardhat node only (the e2e run). Never on mainnet.
# off:   checkout sessions work, nothing is relayed.
RELAYER_MODE=off
PRIVY_RELAYER_WALLET_ID=
PRIVY_RELAYER_ADDRESS=
PRIVY_RELAYER_AUTH_KEY=
# RELAYER_PRIVATE_KEY=       # RELAYER_MODE=local only
RELAYER_RECEIPT_TIMEOUT_MS=15000

# ── Merchant activation (MerchantRegistry owner) ─────────────────────────────
# off (default): merchants are registered by signature and activated by the
# protocol owner out of band. privy: a Privy wallet that owns MerchantRegistry
# and may only setActive / setMaxOrderValue up to the cap below.
REGISTRY_ACTIVATOR=off
PRIVY_REGISTRY_WALLET_ID=
PRIVY_REGISTRY_ADDRESS=
PRIVY_REGISTRY_AUTH_KEY=
MERCHANT_ACTIVATION_CAP_USD=1000
# Owner of every per-merchant payout policy, so the app secret alone can't widen one.
PRIVY_ADMIN_QUORUM_ID=

# ── Automatic payouts (docs/research/privy.md §6) ────────────────────────────
# `pnpm --filter @polaris/business privy:setup-payouts -- --apply` creates these.
NEXT_PUBLIC_PRIVY_PAYOUT_SIGNER_ID=
PRIVY_PAYOUT_SIGNER_ID=
PRIVY_PAYOUT_SIGNER_KEY=

# ── API keys, sessions, webhooks ─────────────────────────────────────────────
# Required in production: HMAC pepper for stored secret-key hashes.
POLARIS_KEY_PEPPER=
# Where checkout sessions send the buyer: ${origin}/pay/${sessionId}.
POLARIS_CHECKOUT_ORIGIN=http://localhost:3000
# This server's public URL (merchant metadata URIs).
POLARIS_PUBLIC_URL=http://localhost:3100
# Browser origins allowed to call /api/relay and /api/public (the checkout origin is always allowed).
POLARIS_APP_ORIGINS=
POLARIS_SESSION_TTL_SECONDS=86400
# Pay in 4 terms offered on sessions: weekly by default; 60 on the demo deployment.
PAY_IN_4_INTERVAL_SECONDS=604800
PAY_IN_4_MIN_CENTS=2000
PAY_IN_4_MAX_CENTS=100000
# Development only: deliver webhooks to localhost / private addresses.
POLARIS_WEBHOOK_ALLOW_PRIVATE=1

# ── Storage and background work ──────────────────────────────────────────────
# sqlite:<path> (default sqlite:.data/polaris.db) or memory:
POLARIS_DB_URL=
# Background loops in this process (chain sync, webhook retries, payouts). Default on
# in development. On serverless, call POST /api/cron/tick with this secret instead.
POLARIS_WORKERS=
CRON_SECRET=
# Behind a proxy you run (Vercel, nginx): trust X-Forwarded-For for rate limits.
POLARIS_TRUST_PROXY=

# ── The web app ──────────────────────────────────────────────────────────────
# "See the demo shop" on the landing and in Developers: the Halcyon demo store
# (apps/shop), which pays through polarispay-sdk. Default http://localhost:3600.
NEXT_PUBLIC_DEMO_SHOP_URL=http://localhost:3600

# ── Development only ─────────────────────────────────────────────────────────
# `next dev` only: 1 = a mock merchant with a labelled sample book, for
# screenshots; empty = the same merchant just after signing up. The mock never
# calls this API. It is blanked in next.config.ts outside development and every
# check also tests NODE_ENV, so a production build compiles it out.
POLARIS_DEV_MOCK_SESSION=
