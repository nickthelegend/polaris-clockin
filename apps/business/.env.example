# Polaris for Business. Copy to .env.local and fill in.

# ── Privy (client) ───────────────────────────────────────────────────────────
# Dashboard > App settings. Without it the app renders a setup screen instead of
# the dashboard, and every API route answers 503.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: an "app client" ID, if you created one for this origin.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Optional: the key quorum ID of the payout signer (automatic daily payouts).
NEXT_PUBLIC_PRIVY_PAYOUT_SIGNER_ID=

# ── Privy (server) ───────────────────────────────────────────────────────────
# PRIVY_APP_ID falls back to NEXT_PUBLIC_PRIVY_APP_ID when unset.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: Dashboard > Configuration > App settings > Verification key. Skips
# the JWKS fetch on the first token verification after a cold start.
PRIVY_VERIFICATION_KEY=

# ── Monad ────────────────────────────────────────────────────────────────────
# Optional: our own RPC for the embedded wallet instead of the public one.
NEXT_PUBLIC_MONAD_TESTNET_RPC=
# Optional: AUSD on Monad testnet. When set, "Withdraw" asks the payout wallet to
# sign an ERC-3009 TransferWithAuthorization, and the server checks that the
# signer is the signed-in merchant's embedded wallet.
NEXT_PUBLIC_AUSD_ADDRESS=
NEXT_PUBLIC_AUSD_EIP712_NAME=AUSD
NEXT_PUBLIC_AUSD_EIP712_VERSION=1

# ── API keys ─────────────────────────────────────────────────────────────────
# Optional pepper for secret-key hashes. Set it in production.
POLARIS_KEY_PEPPER=
